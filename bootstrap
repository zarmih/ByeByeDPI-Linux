#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT_DIR"

command -v uv >/dev/null 2>&1 || {
    echo "Error: uv is required for the developer bootstrap." >&2
    echo "Install uv using its documented package for your system, then rerun ./bootstrap." >&2
    exit 1
}

if [ ! -f requirements-runtime.txt ]; then
    echo "Error: requirements-runtime.txt is missing." >&2
    exit 1
fi

uv venv .venv
uv pip install --python .venv/bin/python -r requirements-runtime.txt
uv pip install --python .venv/bin/python "pytest>=7.0.0"

echo "Bootstrap complete. Build ciadpi with: make -C vendor/byedpi"
echo "Run the application with: ./dev-run"
